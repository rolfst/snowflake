{
  "shell": {
    "font_family": "Cascadia Code NF",
    "time_format": "{:%H:%M}",
    "date_format": "%A, %x",
    "avatar_path": "/home/rolfst/.face",
    "telemetry_enabled": false,
    "clipboard_enabled": true,
    "settings_show_advanced": true,
    "show_location": true,
    "middle_click_opens_widget_settings": true,
    "niri_overview_type_to_launch_enabled": true,
    "animation": {
      "enabled": true,
      "speed": 1.0
    },
    "shadow": {
      "direction": "down"
    },
    "panel": {
      "borders": true,
      "transparency_mode": "glass",
      "control_center_placement": "attached",
      "open_near_click_control_center": true
    },
    "screen_corners": {
      "enabled": true
    },
    "session": {
      "actions": [
        { "action": "lock", "shortcut": "1" },
        { "action": "lock_and_suspend", "shortcut": "2" },
        { "action": "reboot", "shortcut": "3" },
        { "action": "logout", "shortcut": "4" },
        { "action": "shutdown", "shortcut": "5", "variant": "destructive" }
      ]
    }
  },

  "bar": {
    "main": {
      "position": "top",
      "background_opacity": 0.93,
      "radius": 12,
      "margin_ends": 4,
      "margin_edge": 4,
      "shadow": true,
      "auto_hide": false,
      "reserve_space": true,
      "start": [
        "launcher",
        "clock",
        "cpu",
        "temp",
        "ram",
        "active_window",
        "media"
      ],
      "center": [
        "workspaces"
      ],
       "end": [
         "keyboard_toggle",
         "tray",
         "notifications",
         "battery",
         "volume",
         "brightness",
         "control-center"
        ]
    }
  },

  "widget": {
    "clock": {
      "format": "{:%H:%M %a, %b %d}",
      "tooltip_format": "{:%A, %B %d, %Y}",
      "font_weight": 700
    },
    "active_window": {
      "max_length": 145,
      "title_scroll": "none"
    },
    "keyboard_toggle": {
      "type": "custom_button",
      "glyph": "keyboard",
      "tooltip": "Toggle On-Screen Keyboard",
      "command": "pkill -RTMIN wvkbd-mobintl || wvkbd-mobintl"
    }
  },

  "theme": {
    "mode": "dark",
    "source": "builtin",
    "builtin": "Noctalia",
    "templates": {
      "enable_builtin_templates": true,
      "builtin_ids": ["btop", "kitty", "niri"],
      "enable_community_templates": true
    }
  },

  "location": {
    "address": "Rotterdam",
    "auto_locate": false
  },

  "weather": {
    "enabled": true,
    "effects": true,
    "unit": "celsius"
  },

  "calendar": {
    "enabled": true
  },

  "wallpaper": {
    "enabled": true,
    "directory": "/home/rolfst/.local/share/backgrounds",
    "fill_mode": "crop",
    "transition_duration": 1500
  },

  "notification": {
    "enable_daemon": true,
    "position": "top_right",
    "layer": "top"
  },

  "osd": {
    "position": "top_right"
  },

  "dock": {
    "enabled": true,
    "position": "bottom",
    "auto_hide": true,
    "active_monitor_only": true
  },

  "control_center": {
    "shortcuts": [
      { "type": "wifi" },
      { "type": "bluetooth" },
      { "type": "caffeine" },
      { "type": "nightlight" },
      { "type": "notification" },
      { "type": "power_profile" }
    ]
  },

  "system": {
    "monitor": {
      "enabled": true,
      "cpu_poll_seconds": 1.0,
      "memory_poll_seconds": 1.0
    }
  },

  "nightlight": {
    "enabled": false,
    "temperature_night": 4000,
    "temperature_day": 6500
  },

  "audio": {
    "enable_overdrive": false
  },

  "brightness": {
    "enable_ddcutil": false
  }
}
